# Neon Postgres Database Connection String
DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Session Authentication (Must be a strong random secret)
JWT_SECRET="your_random_64_character_jwt_secret_key_here"

# Session Expiration Settings (Policy: 30m to 1h)
SESSION_EXPIRES_IN="1h"
SESSION_TIMEOUT_MINUTES="60"

# Admin Account Initial Credentials
ADMIN_EMAIL="dhamodharan.s@sece.ac.in"
ADMIN_NAME="Dhamodharan S"
ADMIN_PASSWORD="YourSecureAdminPasswordHere!"

# Application Base URL
APP_URL="http://localhost:3000"
