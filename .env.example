# Neon Postgres Database Connection String (get from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key — use a strong random 64-char string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret"

# Gemini API Key (optional — for AI features)
# GEMINI_API_KEY="your_gemini_api_key_here"

# App URL
APP_URL="https://your-vercel-app.vercel.app"

# NOTE: File uploads use Google Drive shareable links — no server-side Drive credentials needed.
# Students upload to their own Drive and paste the shareable link into the form.
